# ---------------------------------------------------------------------------
# Backend environment. Copy to `.env` for local dev (loaded automatically).
# In production, set these as real environment variables.
# ---------------------------------------------------------------------------

# Django
DEBUG=True
SECRET_KEY=dev-only-change-me-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Routing provider (OpenRouteService) — REQUIRED.
# Get a free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# ORS_BASE_URL=https://api.openrouteservice.org

# Geocoding (Nominatim / OpenStreetMap) — no key required.
# Set a descriptive user agent per their usage policy.
GEOCODER_USER_AGENT=weather-aware-routing/1.0

# Weather (Open-Meteo) — no key required.
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Planner tuning
DEFAULT_SAMPLING_MILES=25
PROVIDER_HTTP_TIMEOUT=15

# Production-only (used by config.settings.prod)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# SECURE_SSL_REDIRECT=True
